{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WendNodePack",
  "type": "object",
  "properties": {
    "packFormat": { "type": "integer" },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "label": {
      "type": "object",
      "properties": {
        "en": { "type": "string" },
        "ja": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "requires": {
      "type": "object",
      "properties": {
        "app": { "type": "string" },
        "packs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["app"]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "label": {
            "type": "object",
            "properties": {
              "en": { "type": "string" },
              "ja": { "type": "string" }
            },
            "additionalProperties": { "type": "string" }
          },
          "category": { "type": "string" },
          "icon": { "type": "string" },
          "description": {
            "type": "object",
            "properties": {
              "en": { "type": "string" },
              "ja": { "type": "string" }
            },
            "additionalProperties": { "type": "string" }
          },
          "ports": {
            "type": "object",
            "properties": {
              "in": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" }
                  },
                  "required": ["name", "type"]
                }
              },
              "out": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "type": { "type": "string" },
                    "bbDefault": { "type": "boolean" }
                  },
                  "required": ["name", "type"]
                }
              }
            }
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "default": {},
                "ui": {
                  "type": "object",
                  "properties": {
                    "widget": { "type": "string" },
                    "label": {
                      "type": "object",
                      "additionalProperties": { "type": "string" }
                    },
                    "hint": {
                      "type": "object",
                      "additionalProperties": { "type": "string" }
                    },
                    "browse": { "type": "boolean" }
                  }
                }
              },
              "required": ["name", "type"]
            }
          },
          "impl": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "enum": ["builtin", "provider", "pipeline", "module"] },
              "handler": { "type": "string" },
              "provider": { "type": "string" },
              "recipe": { "type": "string" },
              "promptTemplate": { "type": "string" },
              "customParams": { "type": "object" },
              "outputPort": { "type": "string" },
              "steps": { "type": "array" },
              "file": { "type": "string" }
            },
            "required": ["kind"]
          },
          "compat": {
            "type": "object",
            "properties": {
              "btAction": { "type": "string" },
              "paramMap": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        },
        "required": ["type", "label", "category", "impl"]
      }
    }
  },
  "required": ["packFormat", "id", "version", "label", "nodes"]
}
