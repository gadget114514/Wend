  "nodes": [
    {
      "type": "wend.core.loadLocalFile",
      "label": { "en": "Load Local File", "ja": "ローカルファイル読込" },
      "category": "io",
      "icon": "📂",
      "description": { "en": "Reads a file from disk and puts its content on the blackboard.", "ja": "ディスクからファイルを読み込み、コンテンツをブラックボードに保存します。" },
      "ports": {
        "in": [],
        "out": [
          { "name": "content", "type": "media", "bbDefault": true }
        ]
      },
      "params": [
        {
          "name": "filePath",
          "type": "filepath",
          "required": true,
          "default": "",
          "ui": { "widget": "file", "label": { "en": "File Path", "ja": "ファイルパス" }, "browse": true }
        },
        {
          "name": "outputType",
          "type": "enum",
          "required": false,
          "default": "media",
          "ui": { "widget": "select", "label": { "en": "Output Type", "ja": "出力タイプ" } }
        },
        {
          "name": "outputKey",
          "type": "text",
          "required": true,
          "default": "",
          "ui": { "widget": "bbkey", "label": { "en": "Output Key", "ja": "出力キー" } }
        },
        {
          "name": "outputScope",
          "type": "enum",
          "required": false,
          "default": "run",
          "ui": { "widget": "select", "label": { "en": "Output Scope", "ja": "出力スコープ" } }
        }
      ],
      "impl": { "kind": "builtin", "handler": "loadLocalFile" },
      "compat": {
        "btAction": "loadLocalFile",
        "paramMap": {
          "filePath": "btLocalFilePath",
          "outputKey": "btOutputKey",
          "outputType": "btOutputType",
          "outputScope": "btOutputScope"
        }
      }
    },
